# Vagrant configuration supporting VirtualBox (default) and AWS provider.
# To use AWS: install the plugin `vagrant-aws` and run `vagrant up --provider=aws`.
# Provide AWS credentials via environment variables:
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION, AWS_KEYPAIR, AWS_PRIVATE_KEY_PATH, AWS_AMI
# Do NOT commit credentials into source control.

Vagrant.configure("2") do |config|

  # Default box for local VirtualBox testing
  config.vm.box = "devops-appserver"

  # Port forwarding (kept for local testing; ignored by AWS provider unless overridden)
  config.vm.network "forwarded_port", guest: 80, host: 8080

  # Shared folder for the sample app
  config.vm.synced_folder "../../devops-kungfu", "/home/vagrant/devops-kungfu", create: true

  # AWS provider configuration. Use `vagrant up --provider=aws`.
  config.vm.provider :aws do |aws, override|
    # vagrant-aws uses a dummy box; override to avoid requiring a real box file
    override.vm.box = "dummy"

    # Credentials should be provided via environment variables (do not hardcode)
    aws.access_key_id = ENV['AWS_ACCESS_KEY_ID']
    aws.secret_access_key = ENV['AWS_SECRET_ACCESS_KEY']

    aws.region = ENV['AWS_REGION'] || "us-east-1"
    aws.ami = ENV['AWS_AMI'] || "ami-009d9173b44d0482b"   # set to a valid AMI via env var
    aws.keypair_name = ENV['AWS_KEYPAIR'] || "devops-key"
    aws.instance_type = ENV['AWS_INSTANCE_TYPE'] || "t2.micro"

    # SSH settings for the AWS instance
    override.ssh.username = ENV['AWS_SSH_USER'] || "ubuntu"
    override.ssh.private_key_path = ENV['AWS_PRIVATE_KEY_PATH'] || "~/.ssh/id_rsa"
  end

end
